{
  "name": "@kohaku/kir-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Display library for KIR programs: node graph, flowchart, blocks and sequence views of a .kirgraph (version 3), with live overlays",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KohakuBlueleaf/KohakuNodeIR.git",
    "directory": "packages/kir-graph"
  },
  "main": "./dist/kir-graph.js",
  "module": "./dist/kir-graph.js",
  "exports": {
    ".": "./dist/kir-graph.js",
    "./style.css": "./dist/kir-graph-style.css",
    "./source": "./src/index.js",
    "./source/style.css": "./src/styles/index.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.js",
    "build:dev": "vite build",
    "prepack": "npm run build",
    "examples": "python scripts/generate/examples.py",
    "icons": "node scripts/generate/icons.mjs",
    "test": "node --test tests/layout.test.mjs tests/edit.test.mjs",
    "check": "node scripts/checks/check.mjs",
    "check:anchors": "node scripts/checks/anchors.mjs",
    "check:stable": "node scripts/checks/stability.mjs",
    "shots": "node scripts/inspect/shots.mjs"
  },
  "peerDependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "elkjs": "^0.12.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.28",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "elkjs": "^0.12.0",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.4",
    "vue": "^3.5.44"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true
  }
}
